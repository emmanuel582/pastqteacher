# Local teacher app. Copy this file to .env and fill in the values below.
# Never commit .env. Never put Bachs or service-role secrets in a VITE_ variable.

PORT=3002
TEACHER_ORIGIN=http://127.0.0.1:5175
STUDENT_ORIGIN=http://127.0.0.1:5173
# Existing PastQ API. Use https:// in production.
PASTQ_API_URL=http://127.0.0.1:3000
TEACHER_DATA_DIR=./data

# Public Supabase values for teacher sign-in. Both are required for real accounts.
# The anon key is public by design. Do not put a service-role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Required. At least 32 random characters. Keep this stable: it encrypts private invite codes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TEACHER_STORAGE_SECRET=replace-with-at-least-32-random-characters

# Optional. Comma-separated Supabase user UUIDs allowed to use a teacher workspace.
# Empty lets any signed-in user activate only their own workspace.
TEACHER_USER_IDS=

# Bachs Connect. Leave blank until you enable payments. Sandbox first.
# Live keys must start with sk_live_ and BACHS_ENVIRONMENT must be live.
BACHS_ENVIRONMENT=sandbox
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=

# Public URL of this API. HTTPS in production.
PUBLIC_TEACHER_API_URL=http://127.0.0.1:3002
# Frontend API origin. Empty uses the Vite dev proxy.
VITE_API_URL=
# Same public Supabase values, read by the browser at dev/build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
