# Teacher API and frontend, independent of the student app.
PORT=3002
TEACHER_ORIGIN=http://127.0.0.1:5175
STUDENT_ORIGIN=http://127.0.0.1:5173
PASTQ_API_URL=http://127.0.0.1:3000
TEACHER_DATA_DIR=./data
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Stable random secret, at least 32 characters, encrypts private invite codes.
TEACHER_STORAGE_SECRET=
# Optional: comma-separated Supabase UUIDs allowed to activate teacher workspaces.
# Empty permits authenticated users to activate their OWN workspace only.
TEACHER_USER_IDS=
# Bachs Connect must be enabled on the platform account. Sandbox first.
BACHS_ENVIRONMENT=sandbox
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# Public HTTPS origins in production; keys never belong in VITE_ variables.
PUBLIC_TEACHER_API_URL=http://127.0.0.1:3002
# Frontend API origin. Empty uses the Vite proxy / same-origin deployment.
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
